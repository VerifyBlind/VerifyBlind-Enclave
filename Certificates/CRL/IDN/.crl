                                <div class="position-relative">
                                <img class="h-100 object-fit-cover w-100 mb-3 lazy-img" alt="10 Unit Autogate Baru Siap Mempercepat Layanan Imigrasi di Bandara Ahmad Yani Semarang" data-src="/upload/2026/10/WhatsApp%20Image%202026-10-02%20at%2009.10.14.jpeg?width=400" style="height: 200px !important;">                                <div
