                                <div class="position-relative">
                                <img class="h-100 object-fit-cover w-100 mb-3 lazy-img" alt="Berburu Kasuari dan Kuskus, Dua WN Tiongkok Dideportasi Imigrasi Jayapura" data-src="/upload/2026/Foto%20Berita%20Artikel%20Siaran%20Pers/Berburu%20Kasuari%20dan%20Kuskus%2C%20Dua%20WN%20Tiongkok%20Dideportasi%20Imigrasi%20Jayapura.jpeg?width=400" style="height: 200px !important;">                                <div
                                    class="badge bg-biru-muda rounded-0 small position-absolute top-0 start-0 m-2 text-uppercase">
                                    Siaran Pers                                </div>
