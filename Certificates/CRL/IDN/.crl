	})

	// Menyembunyikan Search Header
	$(document).click(function(e) {
		if ($(e.target).closest("#search_header").length === 0 && $(e.target).closest("#icon_search").length === 0) {
			$('#search_header').hide("drop", { direction: "down" }, 300);
		}
	});
