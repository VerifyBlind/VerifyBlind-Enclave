                                <img class="h-100 object-fit-cover w-100 mb-3 lazy-img" alt="Nekat Jadi PSK, Enam Perempuan Asal Vietnam Diamankan Imigrasi" data-src="/upload/2026/11/1.png?width=400" style="height: 200px !important;">                                <div
                                    class="badge bg-biru-muda rounded-0 small position-absolute top-0 start-0 m-2 text-uppercase">
